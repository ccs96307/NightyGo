+// The direct backends return side-to-move logits, including for black. Normalize
+// both direct eval and MCTS leaves to the white perspective used by the public ABI.
+static void writeWhiteValue(const NNOutput& raw, Player nextPla, float* valueOut) {
+  const bool white = nextPla == P_WHITE;
+  const float scale = gPostProcess.outputScaleMultiplier;
+  const float signedScale = white ? scale : -scale;
+  valueOut[0] = scale * (white ? raw.whiteWinProb : raw.whiteLossProb);
+  valueOut[1] = scale * (white ? raw.whiteLossProb : raw.whiteWinProb);
+  // buildBoardHist uses area scoring with superko; no-result is impossible.
+  valueOut[2] = -1.0e5f;
+  valueOut[3] = signedScale * raw.whiteScoreMean * gPostProcess.scoreMeanMultiplier;
+  valueOut[4] = signedScale * raw.whiteLead * gPostProcess.leadMultiplier;
+}
